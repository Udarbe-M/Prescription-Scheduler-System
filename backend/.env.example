APP_NAME=Prescription Scheduler OCR API
APP_VERSION=0.1.0
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true
DEFAULT_OCR_MODE=auto
HANDWRITTEN_MODEL_NAME=microsoft/trocr-large-handwritten
PRESCRIPTION_MODEL_NAME=chinmays18/medical-prescription-ocr
PRINTED_TEXT_LANGUAGE=en
ENABLE_PRESCRIPTION_MODEL=true
MAX_IMAGE_SIZE_MB=12
